{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User specific financial profile with accounts, cards, categories, and budget limits",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The firebase auth user unique identifier"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "accounts": {
          "type": "array",
          "description": "User list of financial accounts"
        },
        "categories": {
          "type": "array",
          "description": "Financial categories defined by the user"
        },
        "budgets": {
          "type": "array",
          "description": "Budget limits set per category"
        },
        "cards": {
          "type": "array",
          "description": "Connected bank cards"
        }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Single financial operation (expense, income, or transfer)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "accountId": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "type": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "cardId": {
          "type": "string"
        },
        "transferAccountId": {
          "type": "string"
        },
        "transferType": {
          "type": "string"
        }
      },
      "required": ["id", "accountId", "categoryId", "amount", "type", "date"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Host document containing basic profile metadata, accounts, categories, and budgets"
    },
    "users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Subcollection holding individual user transactions to scale beyond the 1MB single-document Firestore limit"
    }
  }
}
